# Copy to .env and fill in. .env is git-ignored; never commit real values.

# System under test: the chatbot behind Caddy (local)
SUT_BASE_URL=http://localhost:8080
SUT_USER=kb
SUT_PASSWORD=change-me
# Chat webhook path (from the KB · Chat workflow's Chat Trigger)
