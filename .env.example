# Copy to .env and fill in. .env is git-ignored; never commit real values.

# System under test: the chatbot behind Caddy (local)
SUT_BASE_URL=http://localhost:8080
# Optional: the chatbot's canonical public address (n8n WEBHOOK_URL), e.g. https://<pc>.<tailnet>.ts.net
SUT_PUBLIC_URL=
SUT_USER=kb
SUT_PASSWORD=change-me
# Chat webhook path (from the KB · Chat workflow's Chat Trigger)
SUT_CHAT_PATH=/webhook/your-chat-trigger-id/chat
# The chatbot's documents folder on this machine; the suite copies fixtures into <this>/qa-fixtures
SUT_DOCUMENTS_DIR=C:\path\to\chatbot\documents
# The chatbot repo (compose.yml + workflows/); used only by the opt-in resilience tests
SUT_REPO_DIR=C:\path\to\chatbot

# Qdrant (read-only checks)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=kb_v1b_gemini001_3072

# AI judge (Groq free tier)
GROQ_API_KEY=change-me
JUDGE_MODEL=qwen/qwen3.8-27b
